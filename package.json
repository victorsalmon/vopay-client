{
  "name": "@clocklobster/vopay-client",
  "publishConfig": {
    "access": "public"
  },
  "version": "1.0.0",
  "packageManager": "pnpm@11.7.0",
  "description": "Product-neutral VoPay payment client (Interac money requests, EFT, webhooks, signature verification)",
  "license": "MIT",
  "author": "Victor Salmon",
  "repository": {
    "type": "git",
    "url": "https://github.com/victorsalmon/vopay-client.git"
  },
  "homepage": "https://github.com/victorsalmon/vopay-client#readme",
  "bugs": {
    "url": "https://github.com/victorsalmon/vopay-client/issues"
  },
  "keywords": [
    "vopay",
    "payments",
    "eft",
    "interac",
    "canada",
    "payment-api",
    "client"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./sandbox": {
      "import": "./dist/sandbox.js",
      "types": "./dist/sandbox.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "audit": "pnpm audit --prod",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"examples/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"examples/**/*.ts\"",
    "test": "vitest run",
    "test:property": "vitest run property",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.10.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
