{
  "name": "@clocklobster/vopay-client",
  "publishConfig": {
    "access": "public"
  },
  "version": "1.0.0",
  "description": "Product-neutral VoPay payment client (Interac money requests, EFT, webhooks, signature verification)",
  "license": "MIT",
  "author": "Victor Salmon",
  "repository": {
    "type": "git",
    "url": "https://github.com/victorsalmon/vopay-client.git"
  },
  "homepage": "https://github.com/victorsalmon/vopay-client#readme",
  "bugs": {
    "url": "https://github.com/victorsalmon/vopay-client/issues"
  },
  "keywords": [
    "vopay",
    "payments",
    "eft",
    "interac",
    "canada",
    "payment-api",
    "client"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./sandbox": {
      "import": "./dist/sandbox.js",
      "types": "./dist/sandbox.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postinstall": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:property": "vitest run property",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.4.1",
    "fast-check": "^4.9.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
